{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/site.webmanifest",
      "dest": "/site.webmanifest"
    },
    {
      "src": "/superadmin-panel",
      "dest": "/api/superadmin-panel.php"
    },
    {
      "src": "/superadmin-panel.php",
      "dest": "/api/superadmin-panel.php"
    },
    {
      "src": "/chipipie-pos.php",
      "dest": "/api/chipipie-pos.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/api/chipipie-pos.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/$1"
    }
  ]
}
