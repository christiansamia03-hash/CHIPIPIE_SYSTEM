# Apache Security Configuration for ChipiPie POS System
Options -Indexes

# Protect sensitive files from direct web browser access
<FilesMatch "^(\.env|\.git|\.htaccess|.*\.sql$|.*\.log$|composer\..*|package\..*)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Fallback block for all dotfiles
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>